# read by agents, not listed by search engines (the pages themselves are)
/*.md
  X-Robots-Tag: noindex
/llms.txt
  X-Robots-Tag: noindex
/llms-full.txt
  X-Robots-Tag: noindex
/llms-full.zh.txt
  X-Robots-Tag: noindex

/vendor/*
